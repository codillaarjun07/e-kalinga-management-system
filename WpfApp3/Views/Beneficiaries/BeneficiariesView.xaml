<!-- EKALINGA_DISTRIBUTION_SEARCH_PROFILE_V2 -->
<UserControl x:Class="WpfApp3.Views.Beneficiaries.BeneficiariesView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:WpfApp3.ViewModels.Beneficiaries" xmlns:conv="clr-namespace:WpfApp3.Views.Allotment">

    <UserControl.DataContext>
        <vm:BeneficiariesViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualsToBoolConverter x:Key="EqualsToBoolConverter" />

        <!-- ========================= -->
        <!-- COLORS / BRUSHES          -->
        <!-- ========================= -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource ThemeColor_Page_F6F8FC}" />
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource ThemeColor_Surface_FFFFFF}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ThemeColor_Accent_1F2A44}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource ThemeColor_AccentHover_4338CA}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource ThemeColor_Accent_EEF2FF}" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="{DynamicResource ThemeColor_Border_E7ECF5}" />
        <SolidColorBrush x:Key="BorderBrushLighter" Color="{DynamicResource ThemeColor_Border_F1F5F9}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource ThemeColor_Accent_0F172A}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ThemeColor_TextSecondary_64748B}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource ThemeColor_DangerSoft_E11D48}" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="{DynamicResource ThemeColor_DangerHover_BE123C}" />

        <DropShadowEffect x:Key="CardShadow" Color="{DynamicResource ThemeColor_Shadow_1E293B}" BlurRadius="28" ShadowDepth="0" Opacity="0.10" />

        <!-- ========================= -->
        <!-- TYPOGRAPHY                -->
        <!-- ========================= -->
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_64748B}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- ========================= -->
        <!-- GENERIC CARDS             -->
        <!-- ========================= -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <!-- Backdrop button -->
        <Style x:Key="BackdropButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon buttons -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_AccentHover_4338CA}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_AccentHover_4338CA}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light button -->
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_64748B}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row action button -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_DangerSoft_FFF1F2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INPUT FIX -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyInputBorderStyle" TargetType="Border" BasedOn="{StaticResource InputBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}" />
        </Style>

        <Style x:Key="PlainInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeBrush_InfoSoft_C7D2FE}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <!-- Searchable Project / Allotment picker -->
        <Style x:Key="ProjectSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeBrush_AccentText_1F2A44}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeBrush_Border_CBD5E1}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ProjectDropButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="38" Height="38" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_EEF2FF}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectOptionListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only classification filter -->
        <Style x:Key="FilterIconComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="14,9" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="PART_DropDownToggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Width="42" Height="42" CornerRadius="12" Background="{TemplateBinding Background}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="15" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_AccentHover_4338CA}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_DropDownToggle}" PopupAnimation="Fade">
                                <Border MinWidth="190" Margin="0,8,0,0" Background="{DynamicResource ThemeBrush_Surface_FFFFFF}" BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}" BorderThickness="1" CornerRadius="14" Padding="6" Effect="{StaticResource CardShadow}">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell alignment -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RoundedPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="RoundedDanger" TargetType="Button">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_DangerSoft_E11D48}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_DangerHover_BE123C}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BENEFICIARY REGISTRY REVAMP STYLES -->
        <SolidColorBrush x:Key="RegistrySuccessBrush" Color="{DynamicResource ThemeColor_SuccessSoft_16A34A}" />
        <SolidColorBrush x:Key="RegistrySuccessSoftBrush" Color="{DynamicResource ThemeColor_SuccessSoft_ECFDF3}" />
        <SolidColorBrush x:Key="RegistryWarningBrush" Color="{DynamicResource ThemeColor_WarningSoft_D97706}" />
        <SolidColorBrush x:Key="RegistryWarningSoftBrush" Color="{DynamicResource ThemeColor_WarningSoft_FFF7E8}" />
        <SolidColorBrush x:Key="RegistryInfoBrush" Color="{DynamicResource ThemeColor_InfoSoft_2563EB}" />
        <SolidColorBrush x:Key="RegistryInfoSoftBrush" Color="{DynamicResource ThemeColor_InfoSoft_EFF6FF}" />
        <SolidColorBrush x:Key="RegistryPurpleBrush" Color="{DynamicResource ThemeColor_PurpleSoft_7C3AED}" />
        <SolidColorBrush x:Key="RegistryPurpleSoftBrush" Color="{DynamicResource ThemeColor_PurpleSoft_F5F3FF}" />

        <Style x:Key="RegistryMetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="RegistrySearchHostStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_FCFDFE}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        

        <Style x:Key="RegistryCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegistryRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="BeneficiaryRow_PreviewMouseLeftButtonUp" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFF}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegistryActionButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
