                        <Button Content="Cancel" Width="140" Height="42" Style="{StaticResource LightButton}" Command="{Binding CloseRemoveCommand}" />

                        <Button Content="Confirm" Margin="16,0,0,0" Style="{StaticResource RoundedDanger}" Command="{Binding ConfirmRemoveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- LOADING OVERLAY -->
        <Grid Panel.ZIndex="950" Background="{DynamicResource ThemeBrush_Glass_66FFFFFF}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="260" Padding="20" CornerRadius="18" Background="{DynamicResource ThemeBrush_Surface_FFFFFF}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Loading beneficiaries..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}" HorizontalAlignment="Center" />

                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,16,0,0" Foreground="{DynamicResource ThemeBrush_AccentText_4F46E5}" Background="{DynamicResource ThemeBrush_InfoSoft_E9EEF7}" />

                    <TextBlock Text="Please wait while data is being fetched." FontSize="12" Foreground="{DynamicResource ThemeBrush_TextSecondary_8A94A6}" Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>