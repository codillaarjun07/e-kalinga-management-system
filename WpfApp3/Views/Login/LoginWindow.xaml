<Window x:Class="WpfApp3.Views.Login.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:WpfApp3.ViewModels.Login" Title="E-Kalinga Management System" Width="1000" Height="660" MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Icon="/Views/Login/ekaling.png" WindowStyle="None" AllowsTransparency="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="LoginNavy" Color="#1F2A44" />
        <SolidColorBrush x:Key="LoginNavyHover" Color="#162038" />
        <SolidColorBrush x:Key="LoginText" Color="#1E293B" />
        <SolidColorBrush x:Key="LoginMuted" Color="#64748B" />
        <SolidColorBrush x:Key="LoginHint" Color="#94A3B8" />
        <SolidColorBrush x:Key="LoginBorder" Color="#DCE5F2" />
        <SolidColorBrush x:Key="LoginSoft" Color="#EEF2FF" />
        <SolidColorBrush x:Key="LoginBlueSoft" Color="#EFF6FF" />
        <SolidColorBrush x:Key="LoginGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="LoginGreenSoft" Color="#ECFDF3" />
        <SolidColorBrush x:Key="LoginDanger" Color="#E11D48" />
        <SolidColorBrush x:Key="LoginDangerSoft" Color="#FFF1F2" />

        <DropShadowEffect x:Key="LoginWindowShadow" BlurRadius="38" ShadowDepth="10" Opacity="0.18" />

        <DropShadowEffect x:Key="LoginSoftShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.09" />

        <DropShadowEffect x:Key="LoginFocusShadow" BlurRadius="12" ShadowDepth="0" Color="#1F2A44" Opacity="0.12" />

        <Style x:Key="LoginFieldBorder" TargetType="Border">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource LoginNavy}" />
                    <Setter Property="Effect" Value="{StaticResource LoginFocusShadow}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="48,10,14,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LoginText}" />
            <Setter Property="CaretBrush" Value="{StaticResource LoginNavy}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="48,10,50,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LoginText}" />
            <Setter Property="CaretBrush" Value="{StaticResource LoginNavy}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="{StaticResource LoginNavy}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginNavy}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource LoginNavyHover}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource LoginNavyHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                                <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginEyeButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource LoginMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="EyeChrome" Background="{TemplateBinding Background}" CornerRadius="11">
                            <TextBlock x:Name="EyeIcon" Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeChrome" Property="Background" Value="{StaticResource LoginSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource LoginNavy}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EyeIcon" Property="Text" Value="" />
                                <Setter Property="Foreground" Value="{StaticResource LoginNavy}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginGlassChip" TargetType="Border">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="0" BorderBrush="#31405A" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                <!-- EKALINGA_FULL_WINDOW_LOGIN_BACKGROUND_V1 -->
                <Border.Background>
                    <ImageBrush ImageSource="/Views/Login/sulop_bg.jpg"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center" />
                </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.86*" />
                    <ColumnDefinition Width="1.14*" />
                </Grid.ColumnDefinitions>

                <!-- Full-window image readability overlay -->
                <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#78101A2B" Offset="0" />
                            <GradientStop Color="#62101A2B" Offset="0.55" />
                            <GradientStop Color="#76101A2B" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- LEFT BRAND EXPERIENCE -->
                <Grid Grid.Column="0">
<Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F01A2744" Offset="0" />
                                <GradientStop Color="#D61F2A44" Offset="0.58" />
                                <GradientStop Color="#A80A1730" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Ellipse Width="340" Height="340" Fill="#10FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-130,0,0" />

                    <Ellipse Width="260" Height="260" Fill="#0CFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-90" />

                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#EFFFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="12">
                                    <Image Source="/Views/Login/ekaling.png" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="E-KALINGA" Foreground="White" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="Government Services Portal" Foreground="#D8E1EF" FontSize="9" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" Padding="11,6" Background="#EFFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource LoginGreen}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionTypeLabel}" Foreground="{StaticResource LoginText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Border Width="150" Height="150" Padding="12" Background="#EAFFFFFF" BorderBrush="#5CFFFFFF" BorderThickness="1" CornerRadius="75" HorizontalAlignment="Left" Effect="{StaticResource LoginSoftShadow}">
                                <Image Source="/Views/Login/sulop_lg.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <TextBlock Text="Public assistance," Foreground="White" FontSize="31" FontWeight="Bold" Margin="0,24,0,0" />

                            <TextBlock Text="made simpler." Foreground="#AFC4FF" FontSize="31" FontWeight="Bold" Margin="0,-2,0,0" />

                            <TextBlock Width="360" Text="A modern platform for validating beneficiaries, managing allotments, and delivering assistance with confidence." Foreground="#D9E2EF" FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,15,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Border Style="{StaticResource LoginGlassChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="White" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Beneficiaries" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource LoginGlassChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="White" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Allotments" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource LoginGlassChip}" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="White" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Distribution" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#BFD1EA" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Secure access for authorized personnel" Foreground="#C9D5E6" FontSize="9" VerticalAlignment="Center" /></StackPanel><TextBlock Text="Municipality of Sulop • Davao del Sur" Foreground="#AFC0D8" FontSize="9" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                    </Grid>
                </Grid>

                <!-- RIGHT SIGN-IN EXPERIENCE -->
                <Grid Grid.Column="1" Background="Transparent">
<Grid Margin="54,34">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        

                        <Border Grid.Row="0" Width="410" Padding="30" Background="White" BorderBrush="{StaticResource LoginBorder}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource LoginSoftShadow}" Margin="0">
                            <StackPanel>
                                <Grid x:Name="LoginCardBrandHeader" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Image Width="142" Height="58" Source="{Binding AppLogo}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" /><Border Grid.Column="1" Height="30" Padding="10,0" Background="#ECFDF3" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="15" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#16A34A" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="Secure sign in" Foreground="#15803D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Border></Grid><TextBlock Text="E-KALINGA PORTAL" Foreground="#51608B" FontSize="10" FontWeight="Bold" Margin="0,0,0,0" />

                                <TextBlock Text="Welcome back" Foreground="{StaticResource LoginText}" FontSize="28" FontWeight="Bold" Margin="0,7,0,0" />

                                <TextBlock Text="Enter your account details to continue." Foreground="{StaticResource LoginMuted}" FontSize="12" Margin="0,6,0,24" />

                                <TextBlock Text="Username" Foreground="{StaticResource LoginText}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8" />

                                <Border Style="{StaticResource LoginFieldBorder}">
                                    <Grid>
                                        <Border Width="30" Height="30" Margin="11,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource LoginNavy}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBox x:Name="UsernameBox" Style="{StaticResource LoginTextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="Enter your username" Margin="48,0,14,0" Foreground="{StaticResource LoginHint}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=UsernameBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=UsernameBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Password" Foreground="{StaticResource LoginText}" FontSize="11" FontWeight="SemiBold" Margin="2,17,0,8" />

                                <Border Style="{StaticResource LoginFieldBorder}">
                                    <Grid>
                                        <Border Width="30" Height="30" Margin="11,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource LoginNavy}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <PasswordBox x:Name="PwdBox" Tag="0" PasswordChanged="PasswordBox_OnPasswordChanged">
                                            <PasswordBox.Style>
                                                <Style TargetType="PasswordBox" BasedOn="{StaticResource LoginPasswordBoxStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </PasswordBox.Style>
                                        </PasswordBox>

                                        <TextBox x:Name="PwdText" Padding="48,10,50,10" TextChanged="PasswordText_OnTextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource LoginTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Text="Enter your password" Margin="48,0,50,0" Foreground="{StaticResource LoginHint}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="False" />
                                                                <Condition Binding="{Binding Tag, ElementName=PwdBox}" Value="0" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PwdBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Enter your password" Margin="48,0,50,0" Foreground="{StaticResource LoginHint}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True" />
                                                                <Condition Binding="{Binding Text, ElementName=PwdText}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PwdText}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ToggleButton x:Name="PwdToggle" Style="{StaticResource LoginEyeButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Checked="PwdToggle_OnChecked" Unchecked="PwdToggle_OnUnchecked" ToolTip="Show or hide password" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,14,0,0" Padding="12,10" Background="{StaticResource LoginDangerSoft}" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="20" Height="20" Background="#FFE4E6" CornerRadius="10" VerticalAlignment="Top">
                                            <TextBlock Text="!" Foreground="{StaticResource LoginDanger}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#BE123C" FontSize="11" LineHeight="17" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Button Margin="0,20,0,0" Style="{StaticResource LoginPrimaryButton}" IsDefault="True" Command="{Binding LoginCommand}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="Sign in to E-Kalinga" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Signing you in..." FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Grid Margin="0,17,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Height="1" Background="#E8EEF6" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="secure access" Foreground="{StaticResource LoginHint}" FontSize="9" Margin="10,0" VerticalAlignment="Center" />

                                    <Border Grid.Column="2" Height="1" Background="#E8EEF6" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource LoginGreen}" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Encrypted database authentication" Foreground="{StaticResource LoginMuted}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,15,0,0"><TextBlock Text="© 2026 Municipality of Sulop" Foreground="#E2E8F0" FontSize="9" TextAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><TextBlock Text="Powered by ArjunCode Technologies" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" /><Ellipse Width="3" Height="3" Fill="#CBD5E1" Margin="8,0" VerticalAlignment="Center" /><TextBlock Text="EKMS-2026-001" Foreground="#CBD5E1" FontSize="9" VerticalAlignment="Center" /></StackPanel></StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- TOAST -->
        <Border Panel.ZIndex="60" Width="330" Padding="13,11" Margin="0,32,32,0" Background="{Binding ToastBackground}" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}" Effect="{StaticResource LoginSoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" Background="#22FFFFFF" CornerRadius="10" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="White" FontSize="11" FontWeight="SemiBold" LineHeight="17" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- LOADING OVERLAY -->
        <Grid Panel.ZIndex="70" Background="#73101A2B" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="340" Padding="24" Background="White" BorderBrush="{StaticResource LoginBorder}" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource LoginWindowShadow}">
                <StackPanel>
                    <Border Width="50" Height="50" Background="{StaticResource LoginSoft}" CornerRadius="16" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="{StaticResource LoginNavy}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Signing you in" Foreground="{StaticResource LoginText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <TextBlock Text="Verifying your account and secure database connection." Foreground="{StaticResource LoginMuted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <ProgressBar IsIndeterminate="True" Height="7" Margin="0,18,0,0" Foreground="{StaticResource LoginNavy}" Background="{StaticResource LoginSoft}" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    <Button x:Name="LoginCloseButton" Panel.ZIndex="90" Width="36" Height="36" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#24FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="CloseButton_Click" ToolTip="Close"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CloseChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseChrome" Property="Background" Value="#3AFFFFFF" /><Setter TargetName="CloseChrome" Property="BorderBrush" Value="#78FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseChrome" Property="Opacity" Value="0.82" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></Grid>
</Window>