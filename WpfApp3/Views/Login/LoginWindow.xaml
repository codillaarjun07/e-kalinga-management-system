<Window x:Class="WpfApp3.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp3.ViewModels.Login"
        Title="E-Kalinga Management System"
        Width="860"
        Height="640"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="/Views/Login/ekaling.png">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="Primary" Color="#2F3C77"/>
        <SolidColorBrush x:Key="Text" Color="#24324B"/>
        <SolidColorBrush x:Key="Muted" Color="#596987"/>
        <SolidColorBrush x:Key="Border" Color="#AAB6D6"/>

        <Style x:Key="InputChrome" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Background" Value="#FAFBFE"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Width" Value="152"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Viewbox Width="20" Height="20" Stretch="Uniform">
                                <Grid Width="24" Height="24">
                                    <Grid x:Name="IconClosed" Opacity="1">
                                        <Path Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"
                                              Data="M4,12 C7.5,16 16.5,16 20,12"/>
                                        <Path Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M7.4,11.2 L6.0,9.4"/>
                                        <Path Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M12,10.8 L12,8.8"/>
                                        <Path Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M16.6,11.2 L18.0,9.4"/>
                                    </Grid>

                                    <Grid x:Name="IconOpen" Opacity="0">
                                        <Path Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent"
                                              Data="M2,12 C4.8,7.2 8.6,5 12,5 C15.4,5 19.2,7.2 22,12 C19.2,16.8 15.4,19 12,19 C8.6,19 4.8,16.8 2,12 Z"/>
                                        <Ellipse Width="6.5"
                                                 Height="6.5"
                                                 Stroke="{TemplateBinding Foreground}"
                                                 StrokeThickness="2"
                                                 Fill="Transparent"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FA"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconOpen" Property="Opacity" Value="1"/>
                                <Setter TargetName="IconClosed" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="IconOpen" Property="Opacity" Value="0"/>
                                <Setter TargetName="IconClosed" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContactButton" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="#32427F"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid >
        <Border CornerRadius="10"
                Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="8"
                                  Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Views/Login/sulop_bg.jpg" Stretch="UniformToFill"/>
                    </Grid.Background>

                    <Rectangle Fill="#5C6F2C1A"/>
                    <Rectangle Fill="#4A21305F"/>

                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F8FAFD"
                                BorderBrush="#E7ECF5"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,5"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="#16A34A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ConnectionTypeLabel}"
                                           Foreground="#475569"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Image Width="220"
                                   Height="220"
                                   Stretch="Uniform"
                                   Source="/Views/Login/sulop_lg.png"
                                   Margin="0,0,0,18"/>

                            <TextBlock Text="Local Government Unit of Sulop"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="24"
                                       TextAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Municipality of Sulop, Davao del Sur"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource ContactButton}">
                                    <TextBlock Text="f" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource ContactButton}">
                                    <TextBlock Text="✉" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource ContactButton}">
                                    <TextBlock Text="☎" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource ContactButton}" Margin="0">
                                    <TextBlock Text="◌" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" Background="#F8FAFD">
                    <Grid Margin="62,42">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <Image Width="210"
                               Height="110"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding AppLogo}"/>

                            <TextBlock Text="Username"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,8"/>

                            <Border Style="{StaticResource InputChrome}">
                                <Grid>
                                    <TextBox x:Name="UsernameBox"
                                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Username"
                                               Margin="14,0,14,0"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=UsernameBox}" Value=""/>
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=UsernameBox}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Rectangle Height="18" Fill="Transparent"/>

                            <TextBlock Text="Password"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,8"/>

                            <Border Style="{StaticResource InputChrome}">
                                <Grid>
                                    <PasswordBox x:Name="PwdBox"
                                                 Tag="0"
                                                 Padding="14,10,48,10"
                                                 PasswordChanged="PasswordBox_OnPasswordChanged">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>

                                    <TextBox x:Name="PwdText"
                                             Padding="14,10,48,10"
                                             TextChanged="PasswordText_OnTextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock Text="Password"
                                               Margin="14,0,48,0"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="False"/>
                                                            <Condition Binding="{Binding Tag, ElementName=PwdBox}" Value="0"/>
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PwdBox}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="Password"
                                               Margin="14,0,48,0"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, ElementName=PwdToggle}" Value="True"/>
                                                            <Condition Binding="{Binding Text, ElementName=PwdText}" Value=""/>
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PwdText}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ToggleButton x:Name="PwdToggle"
                                                  Style="{StaticResource EyeToggle}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Panel.ZIndex="5"
                                                  Checked="PwdToggle_OnChecked"
                                                  Unchecked="PwdToggle_OnUnchecked"
                                                  ToolTip="Show / Hide password"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#C0392B"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                            <Button Command="{Binding LoginCommand}"
                                    HorizontalAlignment="Center"
                                    Margin="0,28,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Log in"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Content" Value="Signing in..."/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0">
                            <TextBlock Text="Created By ArjunCode Technologies"
                                       Foreground="{StaticResource Primary}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="All rights reserved © 2026"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Serial Number: EKMS-2026-001"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Panel.ZIndex="30"
              Background="#66000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="220"
                    Padding="22"
                    Background="White"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,0,0,14"/>
                    <TextBlock Text="Signing in..."
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Please wait while we verify your account."
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
