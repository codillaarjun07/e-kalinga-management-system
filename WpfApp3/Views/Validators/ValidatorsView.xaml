                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Save Profile" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Width="34" Height="34" Padding="0" Command="{Binding CloseSaveConfirmCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Are you sure you want to save this profile?" Margin="0,16,0,0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="Cancel" Width="140" Height="40" Style="{StaticResource OutlineButton}" Command="{Binding CloseSaveConfirmCommand}" />

                        <Button Content="Confirm" Margin="14,0,0,0" Width="160" Height="40" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmSaveProfileCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- LOADING OVERLAY -->
        <Grid Panel.ZIndex="950" Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="260" Padding="20" CornerRadius="18" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Loading validators..." FontSize="16" FontWeight="SemiBold" Foreground="#2E3A59" HorizontalAlignment="Center" />

                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,16,0,0" Foreground="#4F46E5" Background="#E9EEF7" />

                    <TextBlock Text="Please wait while data is being fetched." FontSize="12" Foreground="#8A94A6" Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>