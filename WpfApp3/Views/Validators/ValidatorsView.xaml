="Fill" Value="#0F766E" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Indigenous People"><Setter Property="Fill" Value="#0F766E" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Classification, TargetNullValue=None, FallbackValue=None}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B" /><Style.Triggers><DataTrigger Binding="{Binding Classification}" Value="PWD"><Setter Property="Foreground" Value="#7E22CE" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Farmer"><Setter Property="Foreground" Value="#15803D" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Vendor"><Setter Property="Foreground" Value="#1D4ED8" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Senior Citizen"><Setter Property="Foreground" Value="#C2410C" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Indigenous"><Setter Property="Foreground" Value="#0F766E" /></DataTrigger><DataTrigger Binding="{Binding Classification}" Value="Indigenous People"><Setter Property="Foreground" Value="#0F766E" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></DataTemplate><DataTemplate x:Key="ValidationStatusPillTemplate"><Border Height="26" MinWidth="82" Padding="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" CornerRadius="13"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9" /><Setter Property="BorderBrush" Value="#E2E8F0" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Endorsed"><Setter Property="Background" Value="{StaticResource ValidationSuccessSoftBrush}" /><Setter Property="BorderBrush" Value="#BBF7D0" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Pending"><Setter Property="Background" Value="{StaticResour