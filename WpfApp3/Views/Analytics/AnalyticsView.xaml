<!-- EKALINGA_EXACT_LIGHT_DARK_V1 -->
<UserControl x:Class="WpfApp3.Views.Analytics.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp3.ViewModels.Analytics"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <UserControl.DataContext>
        <vm:AnalyticsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="AnalyticsPrimaryBrush" Color="{DynamicResource ThemeColor_Accent_1F2A44}"/>
        <SolidColorBrush x:Key="AnalyticsPrimaryHoverBrush" Color="{DynamicResource ThemeColor_AccentHover_162038}"/>
        <SolidColorBrush x:Key="AnalyticsPageBrush" Color="{DynamicResource ThemeColor_InfoSoft_F3F5F9}"/>
        <SolidColorBrush x:Key="AnalyticsCardBrush" Color="{DynamicResource ThemeColor_Surface_FFFFFF}"/>
        <SolidColorBrush x:Key="AnalyticsTextBrush" Color="{DynamicResource ThemeColor_Accent_2E3A59}"/>
        <SolidColorBrush x:Key="AnalyticsMutedBrush" Color="{DynamicResource ThemeColor_TextSecondary_6B778C}"/>
        <SolidColorBrush x:Key="AnalyticsBorderBrush" Color="{DynamicResource ThemeColor_Border_E8EEF6}"/>
        <SolidColorBrush x:Key="AnalyticsSoftBrush" Color="{DynamicResource ThemeColor_InfoSoft_EEF2FF}"/>
        <SolidColorBrush x:Key="AnalyticsBlueBrush" Color="{DynamicResource ThemeColor_InfoSoft_2563EB}"/>
        <SolidColorBrush x:Key="AnalyticsBlueSoftBrush" Color="{DynamicResource ThemeColor_InfoSoft_EFF6FF}"/>
        <SolidColorBrush x:Key="AnalyticsGreenBrush" Color="{DynamicResource ThemeColor_SuccessSoft_16A34A}"/>
        <SolidColorBrush x:Key="AnalyticsGreenSoftBrush" Color="{DynamicResource ThemeColor_SuccessSoft_ECFDF3}"/>
        <SolidColorBrush x:Key="AnalyticsAmberBrush" Color="{DynamicResource ThemeColor_Warning_D97706}"/>
        <SolidColorBrush x:Key="AnalyticsAmberSoftBrush" Color="{DynamicResource ThemeColor_WarningSoft_FFF7E8}"/>
        <SolidColorBrush x:Key="AnalyticsPurpleBrush" Color="{DynamicResource ThemeColor_PurpleSoft_7C3AED}"/>
        <SolidColorBrush x:Key="AnalyticsPurpleSoftBrush" Color="{DynamicResource ThemeColor_PurpleSoft_F5F3FF}"/>
        <SolidColorBrush x:Key="AnalyticsRoseBrush" Color="{DynamicResource ThemeColor_Danger_E11D48}"/>
        <SolidColorBrush x:Key="AnalyticsRoseSoftBrush" Color="{DynamicResource ThemeColor_DangerSoft_FFF1F2}"/>

        <DropShadowEffect x:Key="AnalyticsCardShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.06"/>

        <DropShadowEffect x:Key="AnalyticsModalShadow"
                          BlurRadius="34"
                          ShadowDepth="8"
                          Opacity="0.18"/>

        <Style x:Key="AnalyticsCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E8EEF6}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource AnalyticsCardShadow}"/>
        </Style>

        <Style x:Key="AnalyticsMetricCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource AnalyticsCardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="AnalyticsInsightCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E8EEF6}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="AnalyticsSecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_2E3A59}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E8EEF6}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeBrush_Border_CBD5E1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnalyticsPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AnalyticsSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_AccentHover_162038}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeBrush_AccentHover_162038}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnalyticsSectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_2E3A59}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="AnalyticsSectionDescriptionStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_6B778C}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeBrush_InfoSoft_F3F5F9}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,18">

                <!-- COMMAND BAR -->
                <Border Style="{StaticResource AnalyticsCardStyle}"
                        Padding="18,15"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="13"
                                Background="{DynamicResource ThemeBrush_InfoSoft_EEF2FF}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE9D2;"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Reports, KPIs, and operational insights"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <TextBlock Text="{Binding LastUpdatedText, Mode=OneWay}"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Refreshing analytics..."
                                           Foreground="{DynamicResource ThemeBrush_Info_2563EB}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource AnalyticsSecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE72C;"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource AnalyticsPrimaryButtonStyle}"
                                    Command="{Binding ExportPdfCommand}"
                                    Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE749;"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Export PDF"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI CARDS -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,14">
                    <Border Style="{StaticResource AnalyticsMetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="13"
                                    Background="{DynamicResource ThemeBrush_SuccessSoft_ECFDF3}">
                                <TextBlock Text="₱"
                                           Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="MONETARY ALLOTMENT"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalAllotmentAmount, Mode=OneWay}"
                                           Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AnalyticsMetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="13"
                                    Background="{DynamicResource ThemeBrush_InfoSoft_EFF6FF}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE716;"
                                           Foreground="{DynamicResource ThemeBrush_Info_2563EB}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="TOTAL BENEFICIARIES"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding BeneficiariesCount, Mode=OneWay}"
                                           Foreground="{DynamicResource ThemeBrush_Info_2563EB}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AnalyticsMetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="13"
                                    Background="{DynamicResource ThemeBrush_PurpleSoft_F5F3FF}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE8F1;"
                                           Foreground="{DynamicResource ThemeBrush_Purple_7C3AED}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="TOTAL PROJECTS"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProjectsCount, Mode=OneWay}"
                                           Foreground="{DynamicResource ThemeBrush_Purple_7C3AED}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AnalyticsMetricCardStyle}"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="7"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="13"
                                        Background="{DynamicResource ThemeBrush_WarningSoft_FFF7E8}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE73E;"
                                               Foreground="{DynamicResource ThemeBrush_Warning_D97706}"
                                               FontSize="17"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="RELEASE COMPLETION"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ReleaseRateText, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReleasedSummaryText, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding PendingSummaryText, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_Warning_D97706}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar Grid.Row="2"
                                         Height="7"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ReleaseRateValue, Mode=OneWay}"
                                         Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                         Background="{DynamicResource ThemeBrush_InfoSoft_E8EEF6}"
                                         BorderThickness="0"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- OPERATIONAL INSIGHTS -->
                <Border Style="{StaticResource AnalyticsCardStyle}"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Operational Snapshot"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Quick indicators derived from the current report."
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                       FontSize="10"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <UniformGrid Grid.Column="2"
                                     Columns="4">
                            <Border Style="{StaticResource AnalyticsInsightCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="AVERAGE PER PROJECT"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding AverageAllocationText, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AnalyticsInsightCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="BENEFICIARIES / PROJECT"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BeneficiariesPerProjectText, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_Info_2563EB}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AnalyticsInsightCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="RELEASED ASSISTANCE"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ReleasedCount, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AnalyticsInsightCardStyle}"
                                    Margin="0">
                                <StackPanel>
                                    <TextBlock Text="PENDING ASSISTANCE"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PendingReleaseCount, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_Warning_D97706}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- PRIMARY CHARTS -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.38*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="310"
                            Style="{StaticResource AnalyticsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Beneficiary Classification"
                                           Style="{StaticResource AnalyticsSectionTitleStyle}"/>
                                <TextBlock Text="Distribution of beneficiaries across the leading classifications."
                                           Style="{StaticResource AnalyticsSectionDescriptionStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,10,0,0">
                                <lvc:PieChart Series="{Binding BeneficiariesPieSeries}"
                                              LegendLocation="Bottom"
                                              InnerRadius="62"
                                              HoverPushOut="0"
                                              DataTooltip="{x:Null}"/>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,-28,0,0"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{Binding BeneficiariesCount, Mode=OneWay}"
                                               Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="beneficiaries"
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                               FontSize="9"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Height="310"
                            Style="{StaticResource AnalyticsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Yearly Monetary Allotment"
                                           Style="{StaticResource AnalyticsSectionTitleStyle}"/>
                                <TextBlock Text="Total approved monetary allocation grouped by year."
                                           Style="{StaticResource AnalyticsSectionDescriptionStyle}"/>
                            </StackPanel>

                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding YearlyAllotmentSeries}"
                                                LegendLocation="None"
                                                DataTooltip="{x:Null}"
                                                Background="Transparent"
                                                Margin="0,12,0,0">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding YearlyLabels}"
                                              Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                              FontSize="10"
                                              Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding MoneyFormatter}"
                                              Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                              FontSize="10"
                                              MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MONTHLY ACTIVITY -->
                <Border Height="280"
                        Style="{StaticResource AnalyticsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Monthly Project Activity"
                                           Style="{StaticResource AnalyticsSectionTitleStyle}"/>
                                <TextBlock Text="Projects created during the most recent reporting months."
                                           Style="{StaticResource AnalyticsSectionDescriptionStyle}"/>
                            </StackPanel>

                            <Border HorizontalAlignment="Right"
                                    Height="28"
                                    Padding="10,0"
                                    CornerRadius="14"
                                    Background="{DynamicResource ThemeBrush_InfoSoft_EFF6FF}"
                                    BorderBrush="{DynamicResource ThemeBrush_InfoBorder_BFDBFE}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{DynamicResource ThemeBrush_InfoSoft_2563EB}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Project creation trend"
                                               Foreground="{DynamicResource ThemeBrush_Info_1D4ED8}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding ProjectHistorySeries}"
                                            LegendLocation="None"
                                            DataTooltip="{x:Null}"
                                            Background="Transparent"
                                            Margin="0,12,0,0">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding MonthLabels}"
                                          Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                          FontSize="10"
                                          Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding CountFormatter}"
                                          Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                                          FontSize="10"
                                          MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- LOADING OVERLAY -->
        <Grid Panel.ZIndex="50"
              Background="{DynamicResource ThemeBrush_Overlay_660F172A}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="330"
                    Padding="24"
                    CornerRadius="22"
                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                    BorderBrush="{DynamicResource ThemeBrush_Border_E8EEF6}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource AnalyticsModalShadow}">
                <StackPanel>
                    <Border Width="48"
                            Height="48"
                            CornerRadius="15"
                            Background="{DynamicResource ThemeBrush_InfoSoft_EEF2FF}"
                            HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE9D2;"
                                   Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                   FontSize="21"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Refreshing analytics"
                               Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Please wait while the latest report data is loaded."
                               Foreground="{DynamicResource ThemeBrush_TextSecondary_6B778C}"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="7"
                                 Margin="0,18,0,0"
                                 Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                 Background="{DynamicResource ThemeBrush_InfoSoft_EEF2FF}"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>