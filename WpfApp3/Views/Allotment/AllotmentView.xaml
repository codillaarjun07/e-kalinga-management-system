<!-- EKALINGA_EXACT_LIGHT_DARK_V1 -->
<UserControl x:Class="WpfApp3.Views.Allotment.AllotmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp3.ViewModels.Allotment"
             xmlns:local="clr-namespace:WpfApp3.Views.Allotment"
             >

    <UserControl.DataContext>
        <vm:AllotmentViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EqualsToBoolConverter x:Key="EqualsToBoolConverter"/>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{DynamicResource ThemeColor_Page_F6F8FC}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource ThemeColor_Surface_FFFFFF}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ThemeColor_Accent_1F2A44}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource ThemeColor_AccentHover_4338CA}"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource ThemeColor_Accent_EEF2FF}"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="{DynamicResource ThemeColor_Border_E7ECF5}"/>
        <SolidColorBrush x:Key="BorderBrushLighter" Color="{DynamicResource ThemeColor_Border_F1F5F9}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource ThemeColor_Accent_0F172A}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ThemeColor_TextSecondary_64748B}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource ThemeColor_DangerSoft_E11D48}"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="{DynamicResource ThemeColor_DangerHover_BE123C}"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource ThemeColor_Input_FCFDFE}"/>

        <!-- Shadows -->
        <DropShadowEffect x:Key="SoftShadow"
                          Color="{DynamicResource ThemeColor_Shadow_1E293B}"
                          BlurRadius="24"
                          ShadowDepth="0"
                          Opacity="0.10"/>

        <DropShadowEffect x:Key="ModalShadow"
                          Color="{DynamicResource ThemeColor_Shadow_0F172A}"
                          BlurRadius="32"
                          ShadowDepth="0"
                          Opacity="0.16"/>

        <!-- Text -->
        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_64748B}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Card -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- Backdrop -->
        <Style x:Key="BackdropButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_AccentHover_4338CA}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_AccentHover_4338CA}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_DangerSoft_E11D48}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_DangerHover_BE123C}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_64748B}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_EEF2FF}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inputs -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeBrush_InfoSoft_C7D2FE}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="CenteredTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove default selection highlight -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource ThemeColor_TextPrimary_0F172A}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource ThemeColor_TextPrimary_0F172A}"/>
        <!-- ALLOTMENT REGISTRY REVAMP STYLES -->
        <SolidColorBrush x:Key="RegistrySuccessBrush" Color="{DynamicResource ThemeColor_SuccessSoft_16A34A}"/>
        <SolidColorBrush x:Key="RegistrySuccessSoftBrush" Color="{DynamicResource ThemeColor_SuccessSoft_ECFDF3}"/>
        <SolidColorBrush x:Key="RegistryWarningBrush" Color="{DynamicResource ThemeColor_WarningSoft_D97706}"/>
        <SolidColorBrush x:Key="RegistryWarningSoftBrush" Color="{DynamicResource ThemeColor_WarningSoft_FFF7E8}"/>
        <SolidColorBrush x:Key="RegistryInfoBrush" Color="{DynamicResource ThemeColor_InfoSoft_2563EB}"/>
        <SolidColorBrush x:Key="RegistryInfoSoftBrush" Color="{DynamicResource ThemeColor_InfoSoft_EFF6FF}"/>
        <SolidColorBrush x:Key="RegistryPurpleBrush" Color="{DynamicResource ThemeColor_PurpleSoft_7C3AED}"/>
        <SolidColorBrush x:Key="RegistryPurpleSoftBrush" Color="{DynamicResource ThemeColor_PurpleSoft_F5F3FF}"/>

        <Style x:Key="RegistryMetricCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_Surface_FFFFFF}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <Style x:Key="RegistrySearchHostStyle"
               TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_FCFDFE}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegistryFilterHostStyle"
               TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_FCFDFE}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_E7ECF5}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AllotmentColumnHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextSecondary_64748B}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_InfoBorder_E8EEF6}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ThemeBrush_TextPrimary_334155}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_InfoSoft_F1F5F9}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllotmentLeftColumnHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource AllotmentColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="AllotmentCellStyle"
               TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllotmentRowStyle"
               TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_InfoSoft_F8FAFF}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Border_F1F5F9}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AllotmentSelectionCheckBoxStyle"
               TargetType="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Border x:Name="Box"
                                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                                    BorderBrush="{DynamicResource ThemeBrush_Border_CBD5E1}"
                                    BorderThickness="1.5"
                                    CornerRadius="6"/>
                            <TextBlock x:Name="CheckGlyph"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="PartialGlyph"
                                       Text="&#xE738;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_Accent_EEF2FF}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                <Setter TargetName="CheckGlyph"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                <Setter TargetName="PartialGlyph"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllotmentActionButton"
               TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ThemeBrush_Accent_EEF2FF}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllotmentDangerActionButton"
               TargetType="Button"
               BasedOn="{StaticResource AllotmentActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_DangerSoft_FFF1F2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- END ALLOTMENT REGISTRY REVAMP STYLES -->
    </UserControl.Resources>

    <Grid >

        <!-- PAGE CONTENT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SUMMARY -->
            <UniformGrid Grid.Row="0"
                         Columns="4">
                <Border Style="{StaticResource RegistryMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeBrush_InfoSoft_EFF6FF}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8FD;"
                                       Foreground="{DynamicResource ThemeBrush_Info_2563EB}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL ALLOTMENTS"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalAllotments, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RegistryMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeBrush_SuccessSoft_ECFDF3}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE716;"
                                       Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PLANNED BENEFICIARIES"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding PlannedBeneficiaries, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeBrush_Success_16A34A}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RegistryMetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeBrush_WarningSoft_FFF7E8}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8C7;"
                                       Foreground="{DynamicResource ThemeBrush_Warning_D97706}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MONETARY BUDGET"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding MoneyBudgetText, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeBrush_Warning_D97706}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RegistryMetricCardStyle}"
                        Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeBrush_PurpleSoft_F5F3FF}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8EC;"
                                       Foreground="{DynamicResource ThemeBrush_Purple_7C3AED}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="IN-KIND ALLOTMENTS"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding InKindAllotments, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeBrush_Purple_7C3AED}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ALLOTMENT REGISTRY -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                    BorderBrush="{DynamicResource ThemeBrush_Border_F1F5F9}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER / FILTERS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Allotment Registry"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding FoundText, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource RegistrySearchHostStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE721;"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PlainInputTextBox}"
                                             FontSize="12"/>
                                    <TextBlock Text="Search project, company, ID..."
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_94A3B8}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3"
                                Style="{StaticResource RegistryFilterHostStyle}">
                            <ComboBox ItemsSource="{Binding DepartmentFilterOptions}"
                                      SelectedItem="{Binding SelectedDepartmentFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="Filter by department"/>
                        </Border>

                        <Border Grid.Column="5"
                                Style="{StaticResource RegistryFilterHostStyle}">
                            <ComboBox ItemsSource="{Binding SourceOfFundFilterOptions}"
                                      SelectedItem="{Binding SelectedSourceOfFundFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="Filter by source of fund"/>
                        </Border>

                        <Border Grid.Column="7"
                                Style="{StaticResource RegistryFilterHostStyle}">
                            <ComboBox ItemsSource="{Binding BudgetTypeFilterOptions}"
                                      SelectedItem="{Binding SelectedBudgetTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="Filter by budget type"/>
                        </Border>

                        <Button Grid.Column="9"
                                MinWidth="148"
                                Height="42"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddAllotmentCommand}"
                                Content="Add Allotment"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{DynamicResource ThemeBrush_Border_F1F5F9}"
                            Margin="0,14,0,8"/>

                    <!-- BULK ACTION -->
                    <Border Grid.Row="2"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            CornerRadius="12"
                            Background="{DynamicResource ThemeBrush_Accent_EEF2FF}"
                            Visibility="{Binding HasSelectedItems, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE73E;"
                                           Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCount, Mode=OneWay}"
                                           Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                           FontWeight="Bold"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" allotment(s) selected"
                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    MinWidth="170"
                                    Height="34"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding OpenDeleteSelectedCommand}"
                                    Content="{Binding DeleteSelectedButtonText}"/>
                        </Grid>
                    </Border>

                    <!-- TABLE -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="12"
                              Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                              ColumnHeaderHeight="48"
                              RowHeight="56"
                              IsReadOnly="True"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              FocusVisualStyle="{x:Null}"
                              ColumnHeaderStyle="{StaticResource AllotmentColumnHeaderStyle}"
                              RowStyle="{StaticResource AllotmentRowStyle}"
                              CellStyle="{StaticResource AllotmentCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox Style="{StaticResource AllotmentSelectionCheckBoxStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsThreeState="True"
                                              IsChecked="{Binding DataContext.IsAllSelected,
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource AllotmentSelectionCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Project"
                                                    Width="2.15*"
                                                    HeaderStyle="{StaticResource AllotmentLeftColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource ThemeBrush_Accent_EEF2FF}"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE8F1;"
                                                           Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                                           FontSize="15"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName}"
                                                           Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="Company"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                Width="1.0*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Source of Fund"
                                                    Width="1.0*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Height="26"
                                                MinWidth="58"
                                                MaxWidth="130"
                                                Padding="10,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ThemeBrush_InfoSoft_EFF6FF}"
                                                BorderBrush="{DynamicResource ThemeBrush_InfoBorder_BFDBFE}"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{DynamicResource ThemeBrush_InfoSoft_2563EB}"
                                                         Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding SourceOfFund, TargetNullValue=None}"
                                                           Foreground="{DynamicResource ThemeBrush_Info_1D4ED8}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Beneficiaries"
                                                    Width="0.85*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Height="28"
                                                MinWidth="46"
                                                Padding="10,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"
                                                BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <TextBlock Text="{Binding BeneficiariesCount}"
                                                       Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Budget Type"
                                                    Width="0.90*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Height="26"
                                                MinWidth="68"
                                                Padding="10,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                BorderThickness="1"
                                                CornerRadius="13">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_WarningSoft_FFF7E8}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_WarningBorder_FED7AA}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BudgetType}" Value="InKind">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeBrush_PurpleSoft_F5F3FF}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_InfoBorder_DDD6FE}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Margin="0,0,7,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemeBrush_WarningSoft_D97706}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BudgetType}" Value="InKind">
                                                                    <Setter Property="Fill" Value="{DynamicResource ThemeBrush_PurpleSoft_7C3AED}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding BudgetType}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_Warning_B45309}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BudgetType}" Value="InKind">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_Purple_7C3AED}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Budget"
                                                Binding="{Binding BudgetDisplay}"
                                                Width="1.10*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="92"
                                                    Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource AllotmentActionButton}"
                                                    ToolTip="Edit allotment"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE70F;"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
                                            </Button>

                                            <Button Style="{StaticResource AllotmentDangerActionButton}"
                                                    ToolTip="Delete allotment"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE74D;"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- PAGINATION -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <Button Content="Previous"
                                Style="{StaticResource PageButton}"
                                Command="{Binding PreviousPageCommand}"/>

                        <ItemsControl ItemsSource="{Binding PageNumbers}"
                                      Margin="8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource PageButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualsToBoolConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.CurrentPage"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_Accent_1F2A44}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_TextPrimary_FFFFFF}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Next"
                                Style="{StaticResource PageButton}"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ADD / EDIT MODAL -->
        <Grid Panel.ZIndex="900"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeBrush_Overlay_800F172A}"/>

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="980"
                    MaxHeight="760"
                    CornerRadius="24"
                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                    BorderBrush="{DynamicResource ThemeBrush_Border_F1F5F9}"
                    BorderThickness="1"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                CornerRadius="13"
                                Background="{DynamicResource ThemeBrush_Accent_EEF2FF}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8F1;"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"/>
                            <TextBlock Text="Configure project information, beneficiary capacity, and budget allocation."
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Style="{StaticResource CloseButtonStyle}"
                                Command="{Binding CloseFormCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8BB;"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PROJECT INFORMATION -->
                            <Border Grid.Column="0"
                                    Padding="20"
                                    CornerRadius="18"
                                    Background="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"
                                    BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Project Information"
                                               Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                               FontSize="16"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Basic identity and ownership of the allotment."
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                               FontSize="11"
                                               Margin="0,4,0,18"/>

                                    <TextBlock Text="Project Name"
                                               Style="{StaticResource FieldLabelText}"/>
                                    <Border Style="{StaticResource InputBorderStyle}">
                                        <TextBox Text="{Binding ProjectNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PlainInputTextBox}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ProjectNameError}"
                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                               FontSize="11"
                                               Margin="2,6,0,0"
                                               Visibility="{Binding HasProjectNameError, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="Company"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,18,0,8"/>
                                    <Border Style="{StaticResource InputBorderStyle}">
                                        <TextBox Text="{Binding CompanyInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PlainInputTextBox}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CompanyError}"
                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                               FontSize="11"
                                               Margin="2,6,0,0"
                                               Visibility="{Binding HasCompanyError, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="Department"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding Departments}"
                                              SelectedItem="{Binding DepartmentInput}"
                                              Style="{StaticResource ModernComboBox}"/>
                                    <TextBlock Text="{Binding DepartmentError}"
                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                               FontSize="11"
                                               Margin="2,6,0,0"
                                               Visibility="{Binding HasDepartmentError, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="Source of Fund"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding SourcesOfFund}"
                                              SelectedItem="{Binding SourceOfFundInput}"
                                              Style="{StaticResource ModernComboBox}"/>
                                    <TextBlock Text="{Binding SourceOfFundError}"
                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                               FontSize="11"
                                               Margin="2,6,0,0"
                                               Visibility="{Binding HasSourceOfFundError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- CAPACITY / BUDGET -->
                            <Border Grid.Column="2"
                                    Padding="20"
                                    CornerRadius="18"
                                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                                    BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Capacity and Budget"
                                               Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                               FontSize="16"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Set the planned beneficiary count and allocation type."
                                               Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                               FontSize="11"
                                               Margin="0,4,0,18"/>

                                    <TextBlock Text="Number of Beneficiaries"
                                               Style="{StaticResource FieldLabelText}"/>
                                    <Border Style="{StaticResource InputBorderStyle}">
                                        <TextBox Text="{Binding BeneficiariesInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PlainInputTextBox}"
                                                 PreviewTextInput="DigitsOnly_PreviewTextInput"
                                                 PreviewKeyDown="BlockSpace_PreviewKeyDown"
                                                 Tag="digits"/>
                                    </Border>
                                    <TextBlock Text="{Binding BeneficiariesError}"
                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                               FontSize="11"
                                               Margin="2,6,0,0"
                                               Visibility="{Binding HasBeneficiariesError, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Text="Budget Type"
                                               Style="{StaticResource FieldLabelText}"
                                               Margin="0,18,0,8"/>
                                    <ComboBox ItemsSource="{Binding BudgetTypes}"
                                              SelectedItem="{Binding BudgetTypeInput}"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- MONEY -->
                                    <StackPanel Margin="0,18,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BudgetTypeInput}" Value="Money">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Padding="14"
                                                CornerRadius="14"
                                                Background="{DynamicResource ThemeBrush_WarningSoft_FFF7E8}"
                                                BorderBrush="{DynamicResource ThemeBrush_WarningBorder_FED7AA}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Monetary Allocation"
                                                           Foreground="{DynamicResource ThemeBrush_Warning_B45309}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Enter the total approved amount."
                                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                                           FontSize="11"
                                                           Margin="0,3,0,12"/>

                                                <TextBlock Text="Budget Amount (₱)"
                                                           Style="{StaticResource FieldLabelText}"/>
                                                <Border Style="{StaticResource InputBorderStyle}">
                                                    <TextBox Text="{Binding BudgetAmountInput, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource PlainInputTextBox}"
                                                             PreviewTextInput="Money_PreviewTextInput"
                                                             PreviewKeyDown="BlockSpace_PreviewKeyDown"
                                                             Tag="money"/>
                                                </Border>
                                                <TextBlock Text="{Binding BudgetAmountError}"
                                                           Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                                           FontSize="11"
                                                           Margin="2,6,0,0"
                                                           Visibility="{Binding HasBudgetAmountError, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- IN-KIND -->
                                    <StackPanel Margin="0,18,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BudgetTypeInput}" Value="InKind">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Padding="14"
                                                CornerRadius="14"
                                                Background="{DynamicResource ThemeBrush_PurpleSoft_F5F3FF}"
                                                BorderBrush="{DynamicResource ThemeBrush_InfoBorder_DDD6FE}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="In-Kind Allocation"
                                                           Foreground="{DynamicResource ThemeBrush_Purple_7C3AED}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Enter the quantity and item or unit."
                                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                                           FontSize="11"
                                                           Margin="0,3,0,12"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0"
                                                            Grid.Column="0"
                                                            Style="{StaticResource InputBorderStyle}">
                                                        <TextBox Text="{Binding BudgetQtyInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource PlainInputTextBox}"
                                                                 PreviewTextInput="DigitsOnly_PreviewTextInput"
                                                                 PreviewKeyDown="BlockSpace_PreviewKeyDown"
                                                                 Tag="digits"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Text="{Binding BudgetQtyError}"
                                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                                               FontSize="11"
                                                               Margin="2,6,0,0"
                                                               Visibility="{Binding HasBudgetQtyError, Converter={StaticResource BoolToVis}}"/>

                                                    <Border Grid.Row="0"
                                                            Grid.Column="2"
                                                            Style="{StaticResource InputBorderStyle}">
                                                        <TextBox Text="{Binding BudgetUnitInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource PlainInputTextBox}"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="2"
                                                               Text="{Binding BudgetUnitError}"
                                                               Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                                               FontSize="11"
                                                               Margin="2,6,0,0"
                                                               Visibility="{Binding HasBudgetUnitError, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>

                                                <TextBlock Text="Example: 100 | sacks of rice"
                                                           Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                                           FontSize="11"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- FOOTER -->
                    <Grid Grid.Row="4">
                        <TextBlock Text="Complete all required fields before saving."
                                   Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Width="132"
                                    Height="44"
                                    Style="{StaticResource LightButton}"
                                    Command="{Binding CloseFormCommand}"/>

                            <Button Content="Save Allotment"
                                    MinWidth="164"
                                    Height="44"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveFormCommand}"
                                    IsEnabled="{Binding CanSave}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- DELETE MODAL -->
        <Grid Panel.ZIndex="910"
              Visibility="{Binding IsDeleteOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeBrush_Overlay_800F172A}"/>

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CancelDeleteCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="560"
                    CornerRadius="24"
                    Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
                    BorderBrush="{DynamicResource ThemeBrush_Border_F1F5F9}"
                    BorderThickness="1"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModalShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                CornerRadius="14"
                                Background="{DynamicResource ThemeBrush_DangerSoft_FFF1F2}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74D;"
                                       Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeleteTitle}"
                                       Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="This operation cannot be undone."
                                       Foreground="{DynamicResource ThemeBrush_Danger_E11D48}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Style="{StaticResource CloseButtonStyle}"
                                Command="{Binding CancelDeleteCommand}">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8BB;"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeBrush_TextSecondary_64748B}"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="16"
                            CornerRadius="14"
                            Background="{DynamicResource ThemeBrush_InfoSoft_F8FAFC}"
                            BorderBrush="{DynamicResource ThemeBrush_Border_E7ECF5}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding DeleteMessage}"
                                   Foreground="{DynamicResource ThemeBrush_AccentText_0F172A}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Border>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="132"
                                Height="44"
                                Style="{StaticResource LightButton}"
                                Command="{Binding CancelDeleteCommand}"/>

                        <Button Content="Delete"
                                Width="140"
                                Height="44"
                                Margin="12,0,0,0"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- LOADING OVERLAY -->
        <Grid Panel.ZIndex="950"
      Background="{DynamicResource ThemeBrush_Glass_66FFFFFF}"
      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="260"
            Padding="20"
            CornerRadius="18"
            Background="{DynamicResource ThemeBrush_Surface_FFFFFF}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Loading allotments..."
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeBrush_AccentText_2E3A59}"
                       HorizontalAlignment="Center"/>

                    <ProgressBar IsIndeterminate="True"
                         Height="8"
                         Margin="0,16,0,0"
                         Foreground="{DynamicResource ThemeBrush_AccentText_1F2A44}"
                         Background="{DynamicResource ThemeBrush_InfoSoft_E9EEF7}"/>

                    <TextBlock Text="Please wait while data is being fetched."
                       FontSize="12"
                       Foreground="{DynamicResource ThemeBrush_TextSecondary_8A94A6}"
                       Margin="0,12,0,0"
                       TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>