<UserControl x:Class="WpfApp3.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp3.ViewModels.Dashboard"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DashboardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="BorderBrush" Value="#E6ECF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinWidth" Value="98"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3A59"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E3A59"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2A44"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F2A44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowsTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E3A59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="MinHeight" Value="142"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#111827"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatAnalyticsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7ECF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFD"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,18">

                <!-- Greeting / clock / quick actions -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding GreetingText}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2E3A59"/>
                        <TextBlock Text="Choose a module below, then review analytics underneath."
                                   Foreground="#8A94A6"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateTimeText}"
                                   Foreground="#2E3A59"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh"
                                    Style="{StaticResource DashboardActionButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Export PDF"
                                    Style="{StaticResource DashboardActionButtonStyle}"
                                    Command="{Binding ExportPdfCommand}"
                                    Background="#2E3A59"
                                    Foreground="White"
                                    BorderBrush="#2E3A59"
                                    MinWidth="116"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Windows 8 style navigation tiles -->
                <TextBlock Text="Navigation"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2E3A59"
                           Margin="0,0,0,10"/>

                <UniformGrid Columns="4"
                             Margin="0,0,0,24">
                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#2E3A59"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="System overview" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateAllotmentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#4F46E5"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="🔀" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Allotment" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Projects and budgets" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateBeneficiariesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#0891B2"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Beneficiaries" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Assigned recipients" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateDistributionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#16A34A"
                            Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Distribution" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Release assistance" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateValidatorsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#EA580C"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="🔐" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Master List" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Validated residents" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateUsersCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#DB2777"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="🖥️" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Users" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Accounts and roles" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#475569"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="⚙️" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="System options" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateAuditLogsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#7C3AED"
                            Margin="0,0,0,0"
                            Visibility="{Binding DataContext.IsSuperadmin, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="🕵" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Audit Logs" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Activity history" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowsTileButtonStyle}"
                            Command="{Binding DataContext.NavigateBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#0F766E"
                            Margin="0,0,0,0"
                            Visibility="{Binding DataContext.IsSuperadmin, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="🗄️" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Backup" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Database safety" FontSize="12" Opacity="0.85" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>

                <!-- Analytics are second priority -->
                <TextBlock Text="Analytics"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2E3A59"
                           Margin="0,0,0,10"/>

                <!-- KPI tablets -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50" Height="50" Background="#E7FAF6" VerticalAlignment="Center">
                                <TextBlock Text="₱" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Total Allotment Amount" Foreground="#8A94A6" FontSize="12"/>
                                <TextBlock Text="{Binding TotalAllotmentAmount}" Foreground="#2E3A59" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50" Height="50" Background="#EEF2FF" VerticalAlignment="Center">
                                <TextBlock Text="👥" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Number of Beneficiaries" Foreground="#8A94A6" FontSize="12"/>
                                <TextBlock Text="{Binding BeneficiariesCount}" Foreground="#2E3A59" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50" Height="50" Background="#FFF3E6" VerticalAlignment="Center">
                                <TextBlock Text="🛠" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Number of Projects" Foreground="#8A94A6" FontSize="12"/>
                                <TextBlock Text="{Binding ProjectsCount}" Foreground="#2E3A59" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50" Height="50" Background="#FDECEC" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Release Status" Foreground="#8A94A6" FontSize="12"/>
                                <TextBlock Text="{Binding StatusSummary}" Foreground="#2E3A59" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Charts -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="320"/>
                        <RowDefinition Height="320"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pie -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource FlatAnalyticsCardStyle}"
                            Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Beneficiary Classification"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#2E3A59"/>

                            <lvc:PieChart Grid.Row="1"
                                          Series="{Binding BeneficiariesPieSeries}"
                                          DataTooltip="{x:Null}"
                                          LegendLocation="Right"
                                          HoverPushOut="8"/>
                        </Grid>
                    </Border>

                    <!-- Yearly -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Yearly Total Money Allotment"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#2E3A59"/>

                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding YearlyAllotmentSeries}"
                                                LegendLocation="None"
                                                Background="Transparent">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding YearlyLabels}"
                                              Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding MoneyFormatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <!-- Monthly area -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            Style="{StaticResource FlatAnalyticsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Projects Created Per Month"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#2E3A59"/>

                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding ProjectHistorySeries}"
                                                LegendLocation="None"
                                                Background="Transparent">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding MonthLabels}"
                                              Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis LabelFormatter="{Binding CountFormatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Panel.ZIndex="50"
              Background="#66FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="260"
                    Padding="20"
                    CornerRadius="0"
                    Background="White"
                    BorderBrush="#E7ECF5"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Loading dashboard..."
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2E3A59"
                               HorizontalAlignment="Center"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="8"
                                 Margin="0,16,0,0"
                                 Foreground="#2E3A59"
                                 Background="#E9EEF7"/>

                    <TextBlock Text="Please wait while data is being fetched."
                               FontSize="12"
                               Foreground="#8A94A6"
                               Margin="0,12,0,0"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
