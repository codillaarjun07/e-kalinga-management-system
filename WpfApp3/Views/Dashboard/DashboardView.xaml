<UserControl x:Class="WpfApp3.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp3.ViewModels.Dashboard">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E3A59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#111827"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4EAF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF6FF"/>
                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="TileSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,30,0,10">

         

                <!-- Metro tile board. First row starts with Greeting tile and Date/Time tile. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="118"/>
                        <RowDefinition Height="158"/>
                        <RowDefinition Height="158"/>
                        <RowDefinition Height="158"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: dashboard header tiles -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource InfoTileStyle}"
                            Margin="0,0,6,6"
                            Background="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding GreetingText}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#2E3A59"/>
                                <TextBlock Text="Choose a tile to open a module. Analytics and system tools are available from this hub."
                                           Foreground="#7D8AA2"
                                           FontSize="13"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="👋"
                                       FontSize="40"
                                       Opacity="0.85"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="3"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource InfoTileStyle}"
                            Margin="0,0,0,6"
                            Background="#1E293B"
                            BorderBrush="#1E293B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🕒"
                                       FontSize="38"
                                       Foreground="White"
                                       Opacity="0.95"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Current Date and Time"
                                           FontSize="13"
                                           Foreground="#CBD5E1"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DateTimeText}"
                                           Foreground="White"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2 -->
                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateAnalyticsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#0284C7"
                            Margin="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Analytics" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="KPIs, charts, yearly allotment, and project trends" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="📈" FontSize="54" Foreground="White" Opacity="0.95" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateAllotmentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#2563EB"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="🔀" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Allotment" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Create and manage projects" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateBeneficiariesCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#16A34A"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="👥" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Beneficiaries" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Assign and review people" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Grid.Column="5"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateDistributionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#EA580C"
                            Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="📦" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Distribution" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Release assistance" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Row 3 -->
                    <Button Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateValidatorsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#7C3AED"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="🔐" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Master List" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Validated residents and beneficiaries" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateUsersCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#DB2777"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="🖥️" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Users" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Accounts and roles" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Grid.Column="3"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#475569"
                            Margin="0,0,6,6">
                        <Grid>
                            <TextBlock Text="⚙️" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Settings" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="System options" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateAuditLogsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Visibility="{Binding DataContext.IsSuperadmin, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}"
                            Background="#0F766E"
                            Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="🕵" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Audit Logs" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="User activity history" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Row 4 -->
                    <Button Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.NavigateBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Visibility="{Binding DataContext.IsSuperadmin, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVis}}"
                            Background="#64748B"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="🗄️" Style="{StaticResource TileIconStyle}"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Backup" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Database safety copy" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.OpenSystemInfoCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#334155"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="ℹ" FontSize="42" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="System Information" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="About this application" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="3"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.OpenNotificationCenterCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#F59E0B"
                            Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="🔔" Style="{StaticResource TileIconStyle}"/>

                            <Border MinWidth="28"
                                    Height="24"
                                    Padding="7,0"
                                    Background="#EF4444"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.UnreadNotificationCount, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DataContext.NotificationBadgeText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Notifications" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="View recent system alerts" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Row="3"
                            Grid.Column="5"
                            Style="{StaticResource TileButtonStyle}"
                            Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="#991B1B"
                            Margin="0,0,0,0">
                        <Grid>
                            <TextBlock Text="⎋" FontSize="34" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Log Out" Style="{StaticResource TileTitleStyle}"/>
                                <TextBlock Text="Exit current session" Style="{StaticResource TileSubtitleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
