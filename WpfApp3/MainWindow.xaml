<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp3.ViewModels"
        Title="E-Kalinga Management System" Height="820" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/ekaling.png"
        Background="#F3F5F9"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SidebarNavListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SidebarNavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F5F9"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="#2E3A59"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1F2A44"/>
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarLogoutButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F5F9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7ECF5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E6ECF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DDE6F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationPanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#2E3A59"/>
            <Setter Property="BorderBrush" Value="#DDE6F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7ECFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDE6F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6ECF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="Transparent"
                Margin="12,18,8,18">
            <Border Background="White"
                    CornerRadius="18"
                    Padding="8"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Opacity="0.12"/>
                </Border.Effect>

                <Grid Width="56">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>

                    <!-- Small logo only -->
                    <Border Grid.Row="0"
                            Width="46"
                            Height="46"
                            CornerRadius="12"
                            Background="#F8FAFD"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip="E-Kalinga Management System">
                        <Image Source="{Binding AppLogo}"
                               Width="36"
                               Height="36"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- Icon-only menu -->
                    <ListBox Grid.Row="1"
                             Style="{StaticResource SidebarNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource SidebarNavListBoxItemStyle}"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             SelectionChanged="ListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="34"
                                      Height="34"
                                      ClipToBounds="True"
                                      ToolTip="{Binding Title}">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Width="22"
                                               Height="24"
                                               TextAlignment="Left"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SidebarLogoutButtonStyle}"
                            ToolTip="Log Out"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="⎋"
                                   FontSize="17"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="18,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PageTitle}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2E3A59"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Notification Bell -->
                        <Button x:Name="NotificationBellButton"
                                Style="{StaticResource TopBarIconButtonStyle}"
                                Command="{Binding ToggleNotificationsCommand}"
                                Margin="0,0,12,0"
                                ToolTip="Notifications"
                                Width="50" Height="50">
                            <Grid Width="42" Height="42">
                                <TextBlock Text="&#xE7ED;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="#2E3A59"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Border MinWidth="18"
                                        Height="18"
                                        Padding="4,0"
                                        Background="#EF4444"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-3,-3,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnreadNotificationCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding NotificationBadgeText}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Popup x:Name="NotificationPopup"
                               PlacementTarget="{Binding ElementName=NotificationBellButton}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               HorizontalOffset="-360"
                               VerticalOffset="10"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border x:Name="NotificationPanelRoot"
                                    Width="420"
                                    MaxHeight="520"
                                    Background="White"
                                    BorderBrush="#E6ECF7"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22"
                                                      ShadowDepth="4"
                                                      Opacity="0.14"/>
                                </Border.Effect>

                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Notifications"
                                                       Foreground="#2E3A59"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Latest audit logs from other users"
                                                       Foreground="#A3AEC2"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Mark read"
                                                Style="{StaticResource NotificationPanelButtonStyle}"
                                                Command="{Binding MarkNotificationsReadCommand}"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <Border Height="1" Background="#EEF2FF" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding NotificationEmptyText}"
                                               Foreground="#A3AEC2"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Margin="0,36">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ScrollViewer MaxHeight="390"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource NotificationItemButtonStyle}"
                                                            Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Open this audit log">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="42"
                                                                    Height="42"
                                                                    Background="#EEF2FF"
                                                                    CornerRadius="21"
                                                                    Margin="0,0,12,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding OperationType}"
                                                                           Foreground="#2E3A59"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1">
                                                                <Grid Margin="0,0,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding Description}"
                                                                               Foreground="#2E3A59"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"/>

                                                                    <Border Grid.Column="1"
                                                                            Background="#DBEAFE"
                                                                            CornerRadius="8"
                                                                            Padding="8,2"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Top">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="NEW"
                                                                                   Foreground="#1D4ED8"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"/>
                                                                    </Border>
                                                                </Grid>

                                                                <TextBlock Foreground="#6B7280"
                                                                           FontSize="12"
                                                                           Margin="0,5,0,0">
                                                                    <Run Text="By "/>
                                                                    <Run Text="{Binding ActorName}"/>
                                                                    <Run Text=" • "/>
                                                                    <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Profile Icon -->
                        <Grid Width="42"
                              Height="42"
                              Margin="0,0,10,0">
                            <Ellipse Fill="#E9EEF7"/>

                            <Image Source="{Binding CurrentUserProfileImage}"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="21,21"
                                                     RadiusX="21"
                                                     RadiusY="21"/>
                                </Image.Clip>
                            </Image>

                            <TextBlock Text="👤"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsCurrentUserProfileImageEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Page host -->
            <Border Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
    </Grid>
</Window>